# AI Provider Selection
# Options: openai, anthropic, gemini, ollama
PRCOPILOT_AI_PROVIDER=openai

# Optional fallback provider if primary fails.
# Feel free to comment out if fallback is not needed
# Options: openai, anthropic, gemini, ollama, or just leave empty
PRCOPILOT_AI_FALLBACK_PROVIDER=

# Enable automatic fallback (true/false)
PRCOPILOT_AI_AUTO_FALLBACK=false

# AI Generation Settings (Applied to all providers)
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=1024
AI_TIMEOUT_MILLIS=30000

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-0

# Google GenAI Configuration (Vertex mode for production)
# Get your project ID from Google Cloud Console; ADC via GOOGLE_APPLICATION_CREDENTIALS.
# Legacy GEMINI_* names still work as fallback (see GOOGLE_GENAI_* below).
GEMINI_PROJECT_ID=your-gcp-project-id
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_PROJECT_ID=your-gcp-project-id
GOOGLE_GENAI_LOCATION=us-central1
GOOGLE_GENAI_MODEL=gemini-2.5-flash
# Prototyping only (no residency/ZDR guarantees): GOOGLE_GENAI_API_KEY=...

# Ollama Configuration (Local Models)
# Ensure Ollama is running: docker run -d -p 11434:11434 ollama/ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# GitHub App Integration (optional — set GITHUB_ENABLED=true to enable)
GITHUB_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
# PEM private key: raw text (with \n escapes allowed) or file:/path/to/key.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_MAX_REQUEST_BYTES=1048576
GITHUB_WEBHOOK_RATELIMITER_LIMIT_FOR_PERIOD=60
GITHUB_WEBHOOK_RATELIMITER_REFRESH_PERIOD=1m
GITHUB_WEBHOOK_RATELIMITER_TIMEOUT_MILLIS=0
PRCOPILOT_CACHE_DIFF_MAX_ENTRY_CHARS=100000
PRCOPILOT_SARIF_MAX_BYTES=5000000
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_ALLOWED_HOSTS=api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_SARIF_CATEGORY=ai-pr-copilot

# PR Copilot Analysis Settings
PRCOPILOT_ANALYSIS_MAX_DIFF_CHARS=50000
# Hard byte ceiling on /api/v1/** JSON bodies, enforced before deserialization (0 is NOT valid here; min 1024)
PRCOPILOT_ANALYSIS_MAX_REQUEST_BYTES=262144
PRCOPILOT_ANALYSIS_DEFAULT_LANGUAGE=en
PRCOPILOT_ANALYSIS_DEFAULT_STYLE=conventional-commits
PRCOPILOT_ANALYSIS_INCLUDE_RAW_MODEL_OUTPUT=false
# Hard ceilings on model-provided list sizes (list-bomb guard)
PRCOPILOT_ANALYSIS_MAX_RISKS=200
PRCOPILOT_ANALYSIS_MAX_SUGGESTED_TESTS=100
PRCOPILOT_ANALYSIS_MAX_TOUCHED_FILES=500
# Opt-in startup reachability ping of provider base URLs (warn-only, never fails startup)
PRCOPILOT_AI_HEALTH_CHECK_PING=false

# Logging (Debug Mode; never logs raw diffs)
PRCOPILOT_LOG_PROMPTS=false
PRCOPILOT_LOG_RESPONSES=false

# Auth
# selfhost = single-user pre-shared key, no IdP. prod = OIDC JWT required + issuer configured.
PRCOPILOT_AUTH_MODE=selfhost
PRCOPILOT_API_KEY=change-me-to-a-long-random-value
# prod only: SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://auth.example.com/realms/ai-pr-copilot

# Responsiveness / resource knobs (all optional, defaults shown)
SERVER_TOMCAT_THREADS_MAX=30
PRCOPILOT_AI_BULKHEAD_SAAS_MAX_CONCURRENT=15
PRCOPILOT_AI_BULKHEAD_OLLAMA_MAX_CONCURRENT=3
PRCOPILOT_RATELIMITER_LIMIT_FOR_PERIOD=30
PRCOPILOT_RATELIMITER_REFRESH_PERIOD=60s
PRCOPILOT_CACHE_DIFF_MAX_SIZE=1000
PRCOPILOT_CACHE_DIFF_TTL=30m
PRCOPILOT_ANALYSIS_MAX_MODEL_OUTPUT_CHARS=1000000
JAVA_MAX_RAM_PERCENTAGE=70

# SARIF + quality gate
PRCOPILOT_SARIF_CONSUMER=github
PRCOPILOT_SARIF_CATEGORY=ai-pr-copilot
PRCOPILOT_SUPPRESS_FILE=.ai-review-ignore.yml
PRCOPILOT_GATE_MIN_LEVEL=note